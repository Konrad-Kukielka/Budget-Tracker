def display_summary():
    print(f"SUMMARY")
    print(f"Your income is £{income}")
    print(f"Your expenses are:")
    for expense in expenses:
        print(f"£{expense}")
    print(f"Your total expense is £{sum(expenses)}")

income = int(input("What is your current monthly income?"))
expenses = [int(input("What is your current monthly expense?"))]
done = input("Do you want to add another expense?")
while done != "n":
    expenses.append(int(input("What is the other expense you want to add")))
    done = input("Do you want to add another expense?")

budget = income - sum(expenses)

if budget >= 0:
    display_summary()
    print(f"Your total budget is £{budget}")
    print("What would you like to do")

else:
    budget = abs(budget)
    display_summary()
    print(f"You are in overdraft by £{budget}")
    print("What would you like to do?")
